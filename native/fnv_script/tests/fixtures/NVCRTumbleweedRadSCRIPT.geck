scn NVCRTumbleweedRadSCRIPT

int iDead
float iTimer
float iTimer2
ref rWeed

Begin OnHit
	set rWeed to this
	kill rWeed 0
	rWeed.disable
end

Begin OnStartCombat
	set rWeed to this
	kill rWeed 0
	rWeed.disable
end

begin onDeath

	set iDead to 1
	disable

end

begin GameMode

	if iDead == 0
	
		if iTimer2 > 1

			RestoreActorValue Health 2
			set iTimer2 to 0
		else
			set iTimer2 to iTimer2 + GetSecondsPassed

		endif

		if iTimer > 3
			set iTimer to 0
			PlaceAtMe vGlowingOneRadiationAuraExplosion
		else
			set iTimer to iTimer + GetSecondsPassed
		endif
	endif

end
